# Runtime state (Tier 2) --- never committed. See docs/origin-prompt.md Part XX.
.se/state/
.se/cache/
.se/workspaces/
# Stable project identity only (schema, id, label, origin) is committed with
# the project so every clone resolves the same memory namespace. Runtime state
# and personal data remain local.
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Runtime memory is private user/project data, never generated source or a
# repository artifact. Store its policy under docs/memory/ instead.
/memory/

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.ppk
*.jks
*.keystore
.netrc
credentials.json
*.tfstate
*.tfstate.*
.terraform/

# Dependencies and build output
node_modules/
dist/
bun.lockb.bak

# Generated derivations are committed on purpose (role-inventory.md,
# ownership-matrix.md) so reviewers can diff them. Nothing else generated is.

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Rendered host integrations are generated from se/agents/ by `se render`.
# Not committed: they are a build output, and committing them invites edits
# in the wrong place.
.agents/skills/
.agents/agents/
.claude/agents/
.claude/skills/
.codex/agents/
.cursor/agents/
.gemini/agents/
.gemini/config/agents/
.opencode/agents/
.opencode/.gitignore
.github/agents/
/AGENTS.md

# Local diagnostics and logs
debug.log

# The Rust CLI is its own git repository.
/se-rust/
